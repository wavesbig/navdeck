generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 单用户账号（M1 仅一条记录）
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// 分类（扁平一层，无嵌套）
model Category {
  id    String @id @default(cuid())
  name  String
  /// 图标路径或图标名（选填）
  icon  String?
  /// 强调色（选填，默认继承主题中性色）
  color String?
  /// 排序，拖拽调整
  order Int    @default(0)
  cards Card[]

  @@map("categories")
}

/// 卡片：代表一个 NAS 服务/链接
model Card {
  id          String   @id @default(cuid())
  name        String
  /// 内网地址
  internalUrl String
  /// 外网地址
  externalUrl String
  /// 图标路径（favicon / 上传 / 图标库）
  icon        String
  /// hover 描述（选填）
  description String?
  /// 关联分类（不填则归「未分类」）
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// 分类内排序，拖拽调整
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Lucky 同步状态（仅当卡片由 Lucky 同步创建时存在）
  ///
  /// 结构：{ ruleId, missing, syncedAt }
  /// - ruleId：Lucky 规则唯一标识（rule:subRule），应用层去重用
  /// - missing：Lucky 侧已删除此规则时置 true，保留卡片但标记失效
  /// - syncedAt：上次同步时间（ISO 字符串）
  ///
  /// 用 Json 而非独立列：lucky 相关状态聚合，未来加字段不用 migrate。
  /// 代价：失去 DB 级 @unique，去重在 service 层用 Set 做。
  lucky       Json?

  @@index([categoryId])
  @@map("cards")
}

/// Widget 实例（多实例，参考手机桌面 widget）
///
/// 每个 widget 类型可重复添加多个实例，每个实例独立配置（顺序、尺寸）。
/// 倒数日/正数日实例通过 instanceId 关联自己的 DateItem 列表。
model WidgetInstance {
  id        String @id @default(cuid())
  /// 'nas-status' | 'resource-gauge' | 'countdown' | 'countup'
  widgetKey String
  /// 排序，拖拽调整
  order     Int    @default(0)
  /// 尺寸档位：'S' | 'M' | 'L'
  /// S=紧凑、M=标准（默认）、L=详细（双栏下独占一行）
  size      String @default("M")
  /// 关联的日期项（仅 countdown/countup 实例用）
  dateItems DateItem[]

  @@index([widgetKey])
  @@map("widget_instances")
}

/// 日期项（属于某个 widget 实例，倒数日 / 正数日共用）
model DateItem {
  id         String   @id @default(cuid())
  /// 所属 widget 实例 id
  instanceId String
  instance   WidgetInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  /// 'countdown' | 'countup'（冗余存储，便于校验 recurring 仅对 countdown 生效）
  widgetKey  String
  name       String
  /// 目标日期（倒数日）或起始日期（正数日）
  date       DateTime
  /// 循环粒度：'week' | 'month' | 'year'，null = 不循环（仅倒数日用，正数日不循环）
  /// week 锚定星期几，month 锚定几号（小月截到月末），year 锚定月日
  recurUnit  String?
  createdAt  DateTime @default(now())

  @@index([instanceId])
  @@map("date_items")
}

/// 全局配置键值对
model UserPreference {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("user_preferences")
  // 存储项：networkMode | theme | searchEngine | widgetLayout | widgetBarWidth | wallpaper
}

/// 壁纸（预设 + 用户上传）
///
/// 一张图适配两种主题（light/dark 共用，靠遮罩调整可读性），
/// 因此不区分 theme，移除了原 light/dark/any 字段。
model Wallpaper {
  id        String   @id @default(cuid())
  name      String
  /// 'preset'（内置预设）| 'upload'（用户上传）
  source    String
  /// 预设为 /wallpapers/xxx.jpg，上传为 /api/wallpapers/file?path=xxx.jpg
  path      String
  /// 缩略图路径（可选，预设可与 path 相同）
  thumbnail String?
  createdAt DateTime @default(now())

  @@map("wallpapers")
}
